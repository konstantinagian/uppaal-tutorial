	<template>
		<name>Cloud</name>
		<declaration>device_id current; // current device

clock t;

// Queue functions
const int QMAX = 2; // queue size (capacity)
device_id list[QMAX];
int[0,QMAX] len = 0; // initialize length

// Put an element at the end of the queue
void enqueue(device_id element)
{
        list[len++] = element;
}

// Remove the front element of the queue
void dequeue()
{
        int i = 0;
        len -= 1;
        while (i &lt; len)
        {
                list[i] = list[i + 1];
                i++;
        }
        list[i] = 0;
}

// Returns the front element of the queue
device_id front()
{
   return list[0];
}
</declaration>
