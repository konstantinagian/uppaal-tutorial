<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.
chan press;
clock t;</declaration>
	<template>
		<name x="5" y="5">Lamp</name>
		<declaration>// Place local declarations here.
</declaration>
		<location id="id0" x="-323" y="-25">
			<name x="-333" y="-59">off</name>
		</location>
		<location id="id1" x="-102" y="-25">
			<name x="-112" y="-59">on</name>
			<label kind="invariant" x="-110" y="0">t &lt;= 30</label>
		</location>
		<init ref="id0"/>
		<transition id="id2">
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="synchronisation" x="-246" y="34">press?</label>
			<nail x="-161" y="25"/>
			<nail x="-289" y="25"/>
		</transition>
		<transition id="id3">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-246" y="-102">press?</label>
			<label kind="assignment" x="-246" y="-76">t = 0</label>
			<nail x="-280" y="-76"/>
			<nail x="-161" y="-76"/>
		</transition>
	</template>
	<template>
		<name>User</name>
		<location id="id4" x="0" y="0">
			<name x="-59" y="-8">idle</name>
		</location>
		<init ref="id4"/>
		<transition id="id5">
			<source ref="id4"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="68" y="-17">press!</label>
			<nail x="59" y="-76"/>
			<nail x="59" y="59"/>
		</transition>
	</template>
	<system>// List one or more processes to be composed into a system.
system Lamp, User;
</system>
	<queries>
		<query>
			<formula>A[] not deadlock
</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 17:18:57 +0300">
			</result>
		</query>
		<query>
			<formula>A[] not (Lamp.on and t &gt; 30)</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-07-08 17:22:23 +0300">
			</result>
		</query>
	</queries>
</nta>
